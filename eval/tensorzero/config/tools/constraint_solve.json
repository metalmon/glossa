{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "assignment": {
      "additionalProperties": true,
      "default": null,
      "description": "field assignments for validation mode (JSON object of field→value)",
      "type": [
        "object",
        "null"
      ]
    },
    "mode": {
      "description": "mode: validate | infer | check",
      "type": "string"
    },
    "source_path": {
      "description": "Source document source_path (which document's constraints to load)",
      "type": "string"
    }
  },
  "required": [
    "source_path",
    "mode"
  ],
  "type": "object"
}
