{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "direction": {
      "default": null,
      "description": "which edges: `out`, `in`, or `both` (default `both`)",
      "type": [
        "string",
        "null"
      ]
    },
    "edge_types": {
      "default": null,
      "description": "keep only these edge/relation types (e.g. REFERENCES); omit for all",
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "n": {
      "default": null,
      "description": "chunk number from a search/read (use with `path`)",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "node": {
      "default": null,
      "description": "graph node id (from a `glossary` line, e.g. `sym:...`)",
      "type": [
        "string",
        "null"
      ]
    },
    "path": {
      "default": null,
      "description": "document path from a search result (use with `n` instead of `node`)",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "type": "object"
}
